{
  "name": "options-trade-ideas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "local:init": "node scripts/init-local-env.mjs",
    "local:up": "docker compose --env-file .env.local up -d --build",
    "local:down": "docker compose --env-file .env.local down",
    "local:logs": "docker compose --env-file .env.local logs --tail=100",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm --filter @trading/api seed",
    "build:shared": "pnpm --filter @trading/config --filter @trading/domain --filter @trading/contracts --filter @trading/media build",
    "build": "pnpm db:generate && pnpm build:shared && pnpm --filter @trading/api --filter @trading/worker build && pnpm --filter @trading/web build",
    "typecheck": "pnpm db:generate && pnpm build:shared && pnpm -r --if-present typecheck",
    "lint": "oxlint apps packages scripts --deny-warnings",
    "test": "pnpm db:generate && pnpm build:shared && pnpm --filter @trading/api --filter @trading/worker build && node --test --test-concurrency=1 packages/*/test/*.test.mjs apps/*/test/*.test.mjs",
    "check:docs": "node scripts/verify-handoff.mjs",
    "contracts:generate": "pnpm --filter @trading/contracts generate",
    "check:contracts": "pnpm --filter @trading/contracts check",
    "test:migrations": "node scripts/verify-empty-database.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:local": "node scripts/smoke-local.mjs",
    "test:resilience": "node scripts/resilience-local.mjs",
    "test:p03:http": "node scripts/check-p03-http.mjs",
    "test:p03:boundaries": "node scripts/check-p03-boundaries.mjs",
    "identity:configure": "node scripts/configure-local-identity.mjs",
    "identity:seed": "node scripts/seed-local-identity.mjs",
    "test:p04:live": "node scripts/verify-p04-live.mjs",
    "test:p04:credentials": "node scripts/verify-keycloak-credential-revocation.mjs",
    "test:p05:http": "node scripts/check-p05-http.mjs",
    "test:p05:live": "node scripts/verify-p05-live.mjs",
    "test:p06:http": "node scripts/check-p06-http.mjs",
    "test:p06:live": "node scripts/verify-p06-live.mjs",
    "test:p07:live": "node scripts/verify-p07-live.mjs",
    "test:p08:live": "node scripts/verify-p08-live.mjs",
    "test:p09:live": "node scripts/verify-p09-live.mjs",
    "test:p10:live": "node scripts/verify-p10-live.mjs",
    "test:p11:live": "node scripts/verify-p11-live.mjs",
    "test:p12:live": "node scripts/verify-p12-live.mjs",
    "test:p13:live": "node scripts/verify-p13-live.mjs",
    "test:p13:last-admin": "pnpm --filter @trading/api --filter @trading/worker build && node apps/api/scripts/verify-p13-last-admin.mjs",
    "test:p14:http": "node scripts/check-p14-http.mjs",
    "test:p14:recovery": "node scripts/p14-recovery-local.mjs",
    "test:p14:load": "node scripts/p14-load-local.mjs",
    "check:p14:source": "node scripts/p14-source-review.mjs",
    "check:p14:release": "node scripts/p14-release-report.mjs",
    "check:p14:operations": "node apps/worker/scripts/p14-operational-check.mjs",
    "test:p14:roles": "node scripts/p14-roles-local.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:inventory": "python3 scripts/release/inventory.py",
    "test:release": "node --test scripts/release/test/*.test.mjs && python3 -m unittest discover -s scripts/release/test -p test_*.py"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.89.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
