# Copy via `node scripts/init-local-env.mjs`; generated credentials go in ignored .env.local.
COMPOSE_PROJECT_NAME=options-trade-ideas

WEB_PORT=3000
API_PORT=3001
KEYCLOAK_PORT=8080
MAILPIT_UI_PORT=8025

APP_DB_NAME=options_app
APP_DB_USER=options_app
APP_DB_PASSWORD=GENERATE_ME
IDENTITY_DB_NAME=keycloak
IDENTITY_DB_USER=keycloak
IDENTITY_DB_PASSWORD=GENERATE_ME
POSTGRES_BOOTSTRAP_PASSWORD=GENERATE_ME

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=GENERATE_ME
SESSION_SECRET=GENERATE_ME
DATA_ENCRYPTION_KEY=GENERATE_ME
PUBLICATION_RENDER_HMAC_SECRET=GENERATE_ME

DATABASE_URL=postgresql://options_app:GENERATE_ME@postgres:5432/options_app?schema=public
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=GENERATE_ME
OIDC_ISSUER=http://auth.localhost:8080/realms/options-trade-ideas
OIDC_CLIENT_ID=options-web
OIDC_CLIENT_SECRET=GENERATE_ME
# Compose derives these from the configured ports; standalone API runs must set them.
APP_ORIGIN=http://localhost:3000
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
OIDC_ACCOUNT_URL=http://auth.localhost:8080/realms/options-trade-ideas/account
TERMS_VERSION=2026-10-19.draft-1
OIDC_MFA_ASSURANCE=2

RELEASE_MODE=local
NODE_ENV=development
STORAGE_DRIVER=local
LOCAL_OBJECTS_PATH=/var/lib/options-trade-ideas/objects
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=local@example.test

# Local synthetic data is labeled Demo data. Public/production startup rejects it.
MARKET_DATA_PROVIDER=synthetic
# Production-only supplier configuration; requires real agreements and DB grants.
# Never put these in NEXT_PUBLIC_* variables or browser configuration.
DATABENTO_API_KEY=
DATABENTO_STOCK_DATASET=
DATABENTO_OPTION_DATASET=
DATABENTO_FUTURE_DATASET=
DATABENTO_SCHEMAS=
DATABENTO_APPROVED_CAPABILITIES=
# Must match approved supplier delay; blank is not production-ready.
DATABENTO_DELAY_SECONDS=
DATABENTO_CALENDAR_CONFIG=

# API-only payment credentials. Fake is persistent, synthetic and local-only.
BILLING_PROVIDER=fake
BILLING_MODE=test
BILLING_PROVIDER_ACCOUNT_ID=local-fake-account
BILLING_LIVE_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_TAX_CONFIGURED=false
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Must name a staffed, monitored mailbox for production; local intake uses Mailpit.
SUPPORT_CONTACT_EMAIL=
SUPPORT_CONTACT_MONITORED=false

# Stable restore-suppression HMAC key; production must set and back it up separately.
# Local development falls back to SESSION_SECRET.
PRIVACY_SUPPRESSION_KEY=

# Production-only P14 inputs: leave empty locally; supply through server secret stores.
# Vercel overwrites x-vercel-forwarded-for; generic forwarding headers are not trusted.
WEB_INGRESS_MODE=
TRUSTED_INGRESS_SECRET=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_TIMEOUT_MS=15000
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM_VERIFIED=false
RESEND_WEBHOOK_SECRET=
BACKUP_POLICY_REVIEWED=false
DEPLOYMENT_REVISION=
# Enable only after domain/TLS verification.
HSTS_ENABLED=false
