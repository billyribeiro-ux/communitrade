    "playwright": "1.64.0",
    "sharp": "0.35.5",
    "@trading/domain": "workspace:*",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "@types/nodemailer": "8.0.2"
