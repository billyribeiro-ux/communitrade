generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// P01 operational probe retained unchanged. Product tables are additive in P02.
model FoundationProbe {
  id String @id

  label String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("foundation_probe")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  oidcIssuer String @map("oidc_issuer")

  oidcSubject String @map("oidc_subject")

  email String? @unique

  emailVerified Boolean @default(false) @map("email_verified")

  synthetic Boolean @default(false)

  status String @default("active")

  onboardingVersion String? @map("onboarding_version")

  declarationVersion String? @map("declaration_version")

  policyVersion String? @map("policy_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile            Profile?
  drafts             Draft[]
  quotaBuckets       QuotaBucket[]
  idempotencyRecords IdempotencyRecord[]
  sessions           AppSession[]
  journalEntries     JournalEntry[]
  watchlists         Watchlist[]
  layouts            SavedLayout[]
  notifications      Notification[]
  savedSearches      SavedSearch[]
  digestSuppression  DigestSuppression?
  emailSuppression   EmailSuppression?
  productEvents      ProductEvent[]

  @@unique([oidcIssuer, oidcSubject])
  @@map("user_account")
}

model Profile {
  moderationHiddenAt DateTime? @map("moderation_hidden_at") @db.Timestamptz(6)
  userId String @id @map("user_id") @db.Uuid

  handle String @unique

  normalizedHandle String @unique @map("normalized_handle")

  displayName String @map("display_name")

  bio String?

  interests Json?

  links Json?

  avatarMediaId String? @map("avatar_media_id") @db.Uuid

  revision Int @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("profile")
}

model Draft {
  id String @id @default(uuid()) @db.Uuid

  ownerUserId String @map("owner_user_id") @db.Uuid

  kind String

  title String?

  thesis String?

  plan Json @default("{}")

  attachmentIds Json @default("[]") @map("attachment_ids")

  revision Int @default(1)

  chartRevision Int @default(0) @map("chart_revision")

  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner     User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, updatedAt])
  @@map("draft")
}

model QuotaBucket {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  metric String

  monthStart DateTime @map("month_start") @db.Timestamptz(6)

  count Int @default(0)

  reservedCount Int @default(0) @map("reserved_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, metric, monthStart])
  @@map("quota_bucket")
}

model IdempotencyRecord {
  id String @id @default(uuid()) @db.Uuid

  actorKey String @map("actor_key")

  route String

  key String

  requestHash String @map("request_hash")

  responseStatus Int? @map("response_status")

  responseBody Json? @map("response_body")

  resourceId String? @map("resource_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([actorKey, route, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid

  eventType String @map("event_type")

  aggregateType String @map("aggregate_type")

  aggregateId String @map("aggregate_id") @db.Uuid

  revision Int

  payload Json

  status String @default("pending")

  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(6)

  attempts Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  @@unique([eventType, aggregateType, aggregateId, revision])
  @@index([status, availableAt])
  @@map("outbox_event")
}

// Each model below represents a separate bounded aggregate. Their domain fields
// remain explicit so authorization, history, and source references are queryable.
model HandleHistory {
  id                String    @id @default(uuid()) @db.Uuid
  oldHandle         String    @unique @map("old_handle")
  userId            String    @map("user_id") @db.Uuid
  changedAt         DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  redirectExpiresAt DateTime? @map("redirect_expires_at") @db.Timestamptz(6)

  @@map("handle_history")
}

model RoleGrant {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  role          String
  grantorUserId String   @map("grantor_user_id") @db.Uuid
  reason        String
  grantedAt     DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  @@unique([userId, role])
  @@map("role_grant")
}

model AppSession {
  id                String    @id @default(uuid()) @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id") @db.Uuid
  issuedAt          DateTime  @map("issued_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  providerSessionId String?   @map("provider_session_id")
  mfaAt             DateTime? @map("mfa_at") @db.Timestamptz(6)
  assurance         String?
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([providerSessionId], map: "app_session_provider_sid_idx")
  @@map("app_session")
}

model AuthTransaction {
  id                    String    @id @default(uuid()) @db.Uuid
  stateHash             String    @unique @map("state_hash")
  nonceHash             String    @map("nonce_hash")
  pkceVerifierEncrypted String    @map("pkce_verifier_encrypted")
  returnIntent          String    @map("return_intent")
  usedAt                DateTime? @map("used_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_transaction")
}

model Instrument {
  id           String   @id @default(uuid()) @db.Uuid
  asset        String
  vendor       String
  vendorId     String   @map("vendor_id")
  underlyingId String?  @map("underlying_id") @db.Uuid
  venue        String
  currency     String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([vendor, vendorId])
  @@map("instrument")
}

model InstrumentMetadataVersion {
  id            String    @id @default(uuid()) @db.Uuid
  instrumentId  String    @map("instrument_id") @db.Uuid
  version       Int
  multiplier    Decimal   @db.Decimal(28, 10)
  tickSize      Decimal   @map("tick_size") @db.Decimal(28, 10)
  strike        Decimal?  @db.Decimal(28, 10)
  expiry        DateTime? @db.Timestamptz(6)
  root          String?
  contractMonth Int?      @map("contract_month")
  contractYear  Int?      @map("contract_year")
  optionType    String?   @map("option_type")
  adjusted      Boolean   @default(false)
  session       Json?
  adjustment    Json?
  sourceId      String?   @map("source_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([instrumentId, version])
  @@map("instrument_metadata_version")
}

model DataCapability {
  id          String    @id @default(uuid()) @db.Uuid
  supplier    String
  agreementId String    @map("agreement_id")
  dataset     String
  audience    String
  purpose     String
  effectiveAt DateTime  @map("effective_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  flags       Json

  @@map("data_capability")
}

model ProviderInstrumentMapping {
  id              String    @id @default(uuid()) @db.Uuid
  instrumentId    String    @map("instrument_id") @db.Uuid
  metadataVersion Int       @map("metadata_version")
  supplier        String
  dataset         String
  rawSymbol       String    @map("raw_symbol")
  effectiveAt     DateTime  @map("effective_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([instrumentId, supplier, effectiveAt])
  @@map("provider_instrument_mapping")
}

model ChartState {
  id                   String   @id @default(uuid()) @db.Uuid
  ownerUserId          String?  @map("owner_user_id") @db.Uuid
  draftId              String?  @map("draft_id") @db.Uuid
  publicationVersionId String?  @map("publication_version_id") @db.Uuid
  schemaVersion        Int      @map("schema_version")
  state                Json
  provenance           Json
  revision             Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("chart_state")
}

model Publication {
  id                String    @id @default(uuid()) @db.Uuid
  authorUserId      String    @map("author_user_id") @db.Uuid
  kind              String
  originalVersionId String?   @map("original_version_id") @db.Uuid
  currentVersionId  String?   @map("current_version_id") @db.Uuid
  visibility        String
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([visibility, publishedAt, id])
  @@index([authorUserId, publishedAt])
  @@map("publication")
}

model PublicationVersion {
  id                String   @id @default(uuid()) @db.Uuid
  publicationId     String   @map("publication_id") @db.Uuid
  sequence          Int
  previousVersionId String?  @map("previous_version_id") @db.Uuid
  terms             Json
  thesis            String?
  chart             Json?
  disclosures       Json?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([publicationId, sequence])
  @@map("publication_version")
}

model PublicationJob {
  id                    String   @id @db.Uuid
  ownerUserId           String   @map("owner_user_id") @db.Uuid
  draftId               String   @map("draft_id") @db.Uuid
  publicationId         String   @map("publication_id") @db.Uuid
  publicationVersionId  String   @map("publication_version_id") @db.Uuid
  status                String
  candidate             Json
  renderNonce           String   @map("render_nonce") @db.Uuid
  renderNonceExpiresAt  DateTime @map("render_nonce_expires_at") @db.Timestamptz(6)
  renderClaimedAt       DateTime? @map("render_claimed_at") @db.Timestamptz(6)
  snapshotObjectKey     String?  @map("snapshot_object_key")
  snapshotChecksum      String?  @map("snapshot_checksum")
  snapshotWidth         Int?     @map("snapshot_width")
  snapshotHeight        Int?     @map("snapshot_height")
  snapshotMime          String?  @map("snapshot_mime")
  failureCode           String?  @map("failure_code")
  attempts              Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([ownerUserId, createdAt])
  @@index([status, createdAt])
  @@map("publication_job")
}

model CorrectionRequest {
  id              String   @id @default(uuid()) @db.Uuid
  authorUserId    String   @map("author_user_id") @db.Uuid
  publicationId   String   @map("publication_id") @db.Uuid
  sourceVersionId String   @map("source_version_id") @db.Uuid
  reason          String
  proposal        Json
  status          String   @default("requested")
  reviewerUserId  String?  @map("reviewer_user_id") @db.Uuid
  reviewReason    String?  @map("review_reason")
  publicationJobId String? @map("publication_job_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("correction_request")
}

model Position {
  id                    String   @id @default(uuid()) @db.Uuid
  ownerUserId           String   @map("owner_user_id") @db.Uuid
  publicPublicationId   String?  @map("public_publication_id") @db.Uuid
  privateJournalEntryId String?  @map("private_journal_entry_id") @db.Uuid
  state                 String
  plan                  Json
  instrumentId          String   @map("instrument_id") @db.Uuid
  metadataVersionId     String   @map("metadata_version_id") @db.Uuid
  remainingQuantity     Int      @map("remaining_quantity")
  initialRisk           Decimal? @map("initial_risk") @db.Decimal(28, 10)
  riskSourceVersionId   String?  @map("risk_source_version_id") @db.Uuid
  calculationVersion    String   @map("calculation_version")
  revision              Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerUserId, state])
  @@map("position")
}

model PositionLeg {
  id                String @id @default(uuid()) @db.Uuid
  positionId        String @map("position_id") @db.Uuid
  instrumentId      String @map("instrument_id") @db.Uuid
  metadataVersionId String @map("metadata_version_id") @db.Uuid
  side              String
  quantity          Int

  @@map("position_leg")
}

model PositionEvent {
  id           String    @id @default(uuid()) @db.Uuid
  positionId   String    @map("position_id") @db.Uuid
  type         String
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(6)
  quantity     Int?
  price        Decimal?  @db.Decimal(28, 10)
  costs        Decimal?  @db.Decimal(28, 10)
  reason       String?
  supersedesId String?   @map("supersedes_id") @db.Uuid
  details      Json      @default("{}")

  @@index([positionId, receivedAt, id])
  @@map("position_event")
}

model OutcomeSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  positionId         String   @map("position_id") @db.Uuid
  sourceEventCutoff  DateTime @map("source_event_cutoff") @db.Timestamptz(6)
  publicationVersionId String? @map("publication_version_id") @db.Uuid
  calculationVersion String   @map("calculation_version")
  eligibility        String
  exclusions         Json?
  net                Decimal? @db.Decimal(28, 10)
  rMultiple          Decimal? @map("r_multiple") @db.Decimal(28, 10)
  costCoverage       String   @map("cost_coverage")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("outcome_snapshot")
}

model Comment {
  id            String    @id @default(uuid()) @db.Uuid
  publicationId String    @map("publication_id") @db.Uuid
  authorUserId  String    @map("author_user_id") @db.Uuid
  replyToId     String?   @map("reply_to_id") @db.Uuid
  rootId        String?   @map("root_id") @db.Uuid
  body          String
  tag           String?
  editedAt      DateTime? @map("edited_at") @db.Timestamptz(6)
  revision      Int       @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  hiddenAt      DateTime? @map("hidden_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publicationId, createdAt, id])
  @@map("comment")
}

model CommentEditHistory {
  id        String   @id @default(uuid()) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  revision  Int
  body      String
  tag       String?
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@unique([commentId, revision])
  @@map("comment_edit_history")
}

model CommentMention {
  id              String   @id @default(uuid()) @db.Uuid
  commentId       String   @map("comment_id") @db.Uuid
  mentionedUserId String   @map("mentioned_user_id") @db.Uuid
  handle          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([commentId, mentionedUserId])
  @@map("comment_mention")
}

model Reaction {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  publicationId String @map("publication_id") @db.Uuid
  type          String @default("helpful")

  @@unique([userId, publicationId])
  @@map("reaction")
}

model Follow {
  id             String   @id @default(uuid()) @db.Uuid
  followerUserId String   @map("follower_user_id") @db.Uuid
  targetUserId   String?  @map("target_user_id") @db.Uuid
  instrumentId   String?  @map("instrument_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("follow")
}

model Bookmark {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  publicationId String   @map("publication_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, publicationId])
  @@map("bookmark")
}

model Mute {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, authorId])
  @@map("mute")
}

model Repost {
  hiddenAt DateTime? @map("hidden_at") @db.Timestamptz(6)
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  publicationId String   @map("publication_id") @db.Uuid
  commentary    String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("repost")
}

model JournalEntry {
  id            String   @id @default(uuid()) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  publicationId String?  @map("publication_id") @db.Uuid
  positionId    String?  @map("position_id") @db.Uuid
  title         String   @default("")
  thesis        String   @default("")
  notes         String?
  tags          String[] @default([])
  review        Json?
  revision      Int      @default(1)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, createdAt])
  @@map("journal_entry")
}

model Watchlist {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  name        String
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@map("watchlist")
}

model WatchlistItem {
  id           String   @id @default(uuid()) @db.Uuid
  listId       String   @map("list_id") @db.Uuid
  instrumentId String   @map("instrument_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([listId, instrumentId])
  @@map("watchlist_item")
}

model SavedLayout {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  name        String
  version     Int
  template    Json
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@map("saved_layout")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  ownerUserId    String    @map("owner_user_id") @db.Uuid
  category       String
  aggregationKey String    @map("aggregation_key")
  internalUrl    String    @map("internal_url")
  text           String    @default("") @db.VarChar(500)
  sourceId       String?   @map("source_id") @db.Uuid
  eventCount     Int       @default(1) @map("event_count")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  owner          User      @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, aggregationKey])
  @@map("notification")
}

model SavedSearch {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  name        String   @db.VarChar(80)
  filters     Json
  revision    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, createdAt, id])
  @@map("saved_search")
}

model DigestSuppression {
  ownerUserId String   @id @map("owner_user_id") @db.Uuid
  suppressedAt DateTime? @map("suppressed_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@map("digest_suppression")
}

model ProductEvent {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  eventName      String   @map("event_name") @db.VarChar(80)
  sourceKey      String   @map("source_key") @db.VarChar(128)
  properties     Json     @default("{}")
  consentVersion String   @map("consent_version") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner          User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@unique([ownerUserId, eventName, sourceKey])
  @@index([createdAt])
  @@index([eventName, createdAt])
  @@map("product_event")
}

model TrustedIngressNonce {
  nonce String @id @db.VarChar(128)
